# Configurações do Banco de Dados PostgreSQL (Central)
POSTGRES_DB=flowcrm
POSTGRES_USER=flowcrm
POSTGRES_PASSWORD=flowcrm_dev_password
CRM_DB_NAME=flowcrm
CRM_DB_USER=flowcrm
CRM_DB_PASSWORD=flowcrm_dev_password

# Para execução local via UV / Python na máquina (porta 5432 exposta pelo container postgres_dev):
DATABASE_URL=postgresql+psycopg://flowcrm:flowcrm_dev_password@localhost:5432/flowcrm

# Ambiente e Segurança
APP_ENV=development
